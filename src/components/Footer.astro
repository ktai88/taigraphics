---
// Footer.astro
---
<footer class="bg-white pt-10 pb-4 border-bottom-gradient-8" role="contentinfo">
    <div class="page-container-992 mt-8">
        <img class="mb-15" src="/footer-logo.png" alt="Client logo's" width="100%"/>
        <p class="text-2xl/10">Enthousiast geworden? Heb je iets nodig?</p>
        <p class="text-2xl/10"><strong>Creativiteit</strong> zit hier! Neem contact op!</p>
        <p class="my-2">UX/UI, Visual Design & Branding</p>
        <a href="/contact" class="btn-primary my-10 py-3 px-5">
            Say hi!
        </a>
        <div class="flex justify-center items-center space-x-5 mt-10">
            <!-- Load Social Icons -->
            <script src="https://code.iconify.design/3/3.1.1/iconify.min.js"></script>
            <a href="https://github.com/ktai88" aria-label="GitHub Profiel" title="GitHub Profiel" target="_blank" rel="noopener noreferrer"><span class="iconify footer-social-icon icon-brand" data-icon="mdi:github"></span></a>
            <a href="http://www.linkedin.com/in/kevintai" aria-label="LinkedIn Profiel" title="LinkedIn Profiel" target="_blank" rel="noopener noreferrer"><span class="iconify footer-social-icon icon-brand" data-icon="mdi:linkedin"></span></a>
            <a href="https://www.behance.net/nescio88" aria-label="Behance Profiel" title="Behance Profiel" target="_blank" rel="noopener noreferrer"><span class="iconify footer-social-icon icon-brand" data-icon="mdi:behance"></span></a>
            <a href="https://dribbble.com/KevinTai88"  aria-label="Dribbble Profiel" title="Dribbble Profiel" target="_blank" rel="noopener noreferrer"><span class="iconify footer-social-icon icon-brand" data-icon="mdi:dribbble"></span></a>
            <a
              href="https://wcag.nl/webscan/?url=https%3A%2F%2Fwww.taigraphics.nl"
              class="wcag-badge"
              aria-label="WCAG 2.1 gescand via wcag.nl — bekijk het rapport"
              title="Bekijk WCAG 2.1 rapport op wcag.nl"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" role="presentation">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>WCAG 2.1</span>
            </a>
        </div>
    </div>
</footer>