---
// Nav.astro
interface Props {
  active?: 'showcase' | 'blog' | 'contact';
}

const { active } = Astro.props as Props;
---

<nav id="main-nav" class="sticky top-3 z-50 bg-white shadow-md mx-auto px-4 pr-9 min-h-[60px] rounded-full flex items-center md:justify-between" aria-label="Hoofd navigatie">
    <!-- Logo -->
    <a href="/" aria-label="TaiGraphics">
    <p class="md:block text-md">
        <img class="hidden sm:block md:w-40" src="/logo.svg" alt="Logo"/>
    </p>
    </a>
    <!-- Navigation -->
    <ul class="flex ml-3 space-x-3 md:space-x-8 text-xs md:text-base">
    <li class="mt-3">
      <a href="/" data-nav-section="ux-ui" class="text-nowrap nav-link">UX/UI</a>
    </li>
    <li class="mt-3">
      <a
        href="/showcase"
        aria-current={active === "showcase" ? "page" : undefined}
        class="text-nowrap nav-link"
      >
        Showcase
      </a>
    </li>
    <li class="mt-3">
      <a
        href="/blog"
        aria-current={active === "blog" ? "page" : undefined}
        class="text-nowrap nav-link"
      >
        On my mind
      </a>
    </li>
    <li class="mt-[7px] flex items-center">
      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Schakel donkere modus">
        <!-- Moon: visible in light mode — aria-hidden set by JS on the visible icon only -->
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <!-- Sun: visible in dark mode — both icons decorative, aria-hidden always true -->
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
    </li>
    <li>
      <a
        href="/contact"
        aria-current={active === "contact" ? "page" : undefined}
        class={`text-nowrap block mt-1 md:mt-1 btn-primary text-xs md:text-sm ${
          active === "contact" ? "ring-2 ring-offset-2 ring-[color:var(--color-primary)] font-semibold" : ""
        }`}
      >
        Say hi!
      </a>
    </li>
    </ul>
</nav>

<script>
  const nav = document.getElementById('main-nav');

  if (nav) {
    const isHomePage = () => {
      const p = window.location.pathname.replace(/\/$/, '') || '/';
      return p === '/' || p === '/index.html';
    };

    const uxUiLink = nav.querySelector('a[data-nav-section="ux-ui"]');

    const updateHomeActive = () => {
      if (!uxUiLink) return;
      if (isHomePage()) {
        uxUiLink.classList.add('nav-link--current-section');
        uxUiLink.setAttribute('aria-current', 'page');
      } else {
        uxUiLink.classList.remove('nav-link--current-section');
        uxUiLink.removeAttribute('aria-current');
      }
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (window.scrollY > 30) {
        nav.classList.add('nav-shrink');
      } else {
        nav.classList.remove('nav-shrink');
      }
    }, { passive: true });

    updateHomeActive();
  }

  // Dark mode toggle
  const themeBtn = document.getElementById('theme-toggle');
  const iconMoon = document.querySelector('.icon-moon');
  const iconSun  = document.querySelector('.icon-sun');

  const syncToggle = (isDark: boolean) => {
    if (themeBtn) {
      themeBtn.setAttribute(
        'aria-label',
        isDark ? 'Schakel naar lichte modus' : 'Schakel naar donkere modus'
      );
    }
    // Both icons are purely decorative inside a labelled button — always aria-hidden="true".
    // The button's aria-label is the sole accessible name; neither SVG needs to be exposed to AT.
    iconMoon?.setAttribute('aria-hidden', 'true');
    iconSun?.setAttribute('aria-hidden',  'true');
  };

  if (themeBtn) {
    syncToggle(document.documentElement.classList.contains('dark'));

    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      syncToggle(isDark);
      try {
        localStorage.setItem('tg_theme', isDark ? 'dark' : 'light');
      } catch (e) {}
    });
  }
</script>