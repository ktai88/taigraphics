---
// Nav.astro
interface Props {
  active?: 'showcase' | 'blog' | 'contact';
}

const { active } = Astro.props as Props;
---

<nav id="main-nav" class="sticky top-3 z-50 bg-white shadow-md mx-auto px-4 pr-9 min-h-[60px] rounded-full flex items-center md:justify-between" aria-label="Hoofd navigatie">
    <!-- Logo -->
    <a href="/" aria-label="TaiGraphics">
    <p class="md:block text-md">
        <img class="hidden sm:block md:w-40" src="/logo.svg" alt="Logo"/>
    </p>
    </a>
    <!-- Navigation -->
    <ul class="flex ml-3 space-x-3 md:space-x-8 text-black text-xs md:text-base">
    <li class="mt-3">
      <a href="/" data-nav-section="ux-ui" class="text-nowrap nav-link">UX/UI</a>
    </li>
    <li class="mt-3">
      <a
        href="/showcase"
        aria-current={active === "showcase" ? "page" : undefined}
        class="text-nowrap nav-link"
      >
        Showcase
      </a>
    </li>
    <li class="mt-3">
      <a
        href="/blog"
        aria-current={active === "blog" ? "page" : undefined}
        class="text-nowrap nav-link"
      >
        On my mind
      </a>
    </li>
    <li>
      <a
        href="/contact"
        aria-current={active === "contact" ? "page" : undefined}
        class={`text-nowrap block mt-1 md:mt-1 btn-primary text-xs md:text-sm ${
          active === "contact" ? "ring-2 ring-offset-2 ring-[color:var(--color-primary)] font-semibold" : ""
        }`}
      >
        Say hi!
      </a>
    </li>
    </ul>
</nav>

<script>
  const nav = document.getElementById('main-nav');

  if (nav) {
    const isHomePage = () => {
      const p = window.location.pathname.replace(/\/$/, '') || '/';
      return p === '/' || p === '/index.html';
    };

    const uxUiLink = nav.querySelector('a[data-nav-section="ux-ui"]');

    const updateHomeActive = () => {
      if (!uxUiLink) return;
      if (isHomePage()) {
        uxUiLink.classList.add('nav-link--current-section');
        uxUiLink.setAttribute('aria-current', 'page');
      } else {
        uxUiLink.classList.remove('nav-link--current-section');
        uxUiLink.removeAttribute('aria-current');
      }
    };

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (window.scrollY > 30) {
        nav.classList.add('nav-shrink');
      } else {
        nav.classList.remove('nav-shrink');
      }
    }, { passive: true });

    updateHomeActive();
  }
</script>