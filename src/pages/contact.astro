---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout active="contact" title="Contact - Say hi | TaiGraphics">

    <header class="mt-12 mb-10">
      <div class="page-container-992 py-6">
        <h1 class="text-4xl">Say <strong>hi!</strong></h1>
        <p class="mt-6 mb-2 font-semibold text-xs uppercase tracking-[0.1em] text-label"><span class="border-t-2 border-primary pt-3">Plan een gesprek!</span></p>
        <p class="leading-8 mt-4 max-w-[560px]">Heb je een project, een vraag of wil je gewoon kennismaken? Plan direct een moment in of stuur een bericht via <a href="https://www.linkedin.com/in/kevintai/" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">LinkedIn</a>.</p>
      </div>
    </header>

    <section id="ux" class="section-alt">
      <div class="page-container-992">
      <!-- Calendly inline widget begin -->
      <div class="calendly-inline-widget" role="region" aria-label="Agenda - plan een gesprek in" data-url="https://calendly.com/taigraphics-info/30min?hide_event_type_details=1&hide_gdpr_banner=1&primary_color=0000ff" style="min-width:320px;height:700px;"></div>
      <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
      <!-- Calendly inline widget end -->
      </div>
    </section>

</BaseLayout>